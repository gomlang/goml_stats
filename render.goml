package goml_stats;

use std::json;
use std::text;

fn number(value: isize) -> json::Value {
    json::Value::Number(value.to_string())
}

fn counts_json(counts: Counts) -> json::Value {
    json::Value::Object(
        Vec::from_array(
            [
                ("files", number(counts.files)),
                ("test_files", number(counts.test_files)),
                ("lines", number(counts.lines)),
                ("code", number(counts.code)),
                ("comments", number(counts.comments)),
                ("blank", number(counts.blank)),
                ("bytes", number(counts.bytes)),
            ],
        ),
    )
}

fn groups_json(groups: Vec[Group]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for group in groups {
        result.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("path", json::Value::String(group.path)),
                        ("counts", counts_json(group.counts)),
                    ],
                ),
            ),
        );
    }
    json::Value::Array(result)
}

pub fn render_json(report: Report, include_files: bool) -> string {
    let fields = Vec::from_array(
        [
            ("schema_version", number(1)),
            ("root", json::Value::String(report.root)),
            ("module_count", number(report.modules.len())),
            ("package_count", number(report.packages.len())),
            ("totals", counts_json(report.totals)),
            ("unassigned", counts_json(report.unassigned)),
            ("modules", groups_json(report.modules)),
            ("packages", groups_json(report.packages)),
        ],
    );
    if include_files {
        let files: Vec[json::Value] = Vec::new();
        for file in report.files {
            files.push(
                json::Value::Object(
                    Vec::from_array(
                        [
                            ("path", json::Value::String(file.path)),
                            ("package", json::Value::String(file.package_path)),
                            (
                                "module",
                                match file.module_path {
                                    Some(value) => json::Value::String(value),
                                    None => json::Value::Null,
                                },
                            ),
                            ("counts", counts_json(file.counts)),
                        ],
                    ),
                ),
            );
        }
        fields.push(("files", json::Value::Array(files)));
    }
    json::encode(json::Value::Object(fields))
}

fn count_columns(counts: Counts) -> Vec[isize] {
    Vec::from_array(
        [counts.files, counts.lines, counts.code, counts.comments, counts.blank, counts.bytes],
    )
}

fn column_widths(totals: Counts) -> Vec[isize] {
    let widths = Vec::new();
    for value in count_columns(totals) {
        let length = value.to_string().byte_len();
        widths.push(
            if length < 10 {
                10
            } else {
                length + 1
            },
        );
    }
    widths
}

fn padded(value: string, width: isize) -> string {
    text::repeat(
        " ",
        if value.byte_len() < width {
            width - value.byte_len()
        } else {
            1
        },
    )
        + value
}

fn header(output: text::StringBuilder, title: string, widths: Vec[isize]) -> () {
    let names = Vec::from_array(["Files", "Lines", "Code", "Comments", "Blank", "Bytes"]);
    for index in 0..names.len() {
        output.write_string(padded(names[index], widths[index]));
    }
    output.write_line("  " + title);
}

fn display_path(value: string) -> string {
    let output = text::StringBuilder::new();
    for character in value.chars() {
        let escaped = match character {
            '\\' => "\\\\",
            '\n' => "\\n",
            '\r' => "\\r",
            '\t' => "\\t",
            _ => "",
        };
        if escaped != "" {
            output.write_string(escaped);
            continue;
        }
        let code = character.to_u32();
        let digits = if code < 32 || (code >= 127 && code <= 159) {
            2
        } else if (code >= 0x202a && code <= 0x202e) || (code >= 0x2066 && code <= 0x2069)
            || code == 0x061c
            || code == 0x200e
            || code == 0x200f
            || code == 0x2028
            || code == 0x2029 {
            4
        } else {
            0
        };
        if digits == 0 {
            output.write_char(character);
        } else {
            output.write_string(
                if digits == 2 {
                    "\\x"
                } else {
                    "\\u"
                },
            );
            let mut shift = (digits - 1) * 4;
            while shift >= 0 {
                let index = ((code >> shift) & 15).to_isize();
                output.write_string("0123456789abcdef".byte_slice(index, index + 1));
                shift -= 4;
            }
        }
    }
    output.finish()
}

fn row(output: text::StringBuilder, counts: Counts, name: string, widths: Vec[isize]) -> () {
    let values = count_columns(counts);
    for index in 0..values.len() {
        output.write_string(padded(values[index].to_string(), widths[index]));
    }
    output.write_line("  " + display_path(name));
}

fn group_table(output: text::StringBuilder, title: string, groups: Vec[Group], widths: Vec[isize]) -> () {
    output.write_line("");
    header(output, title, widths);
    for group in groups {
        row(output, group.counts, group.path, widths);
    }
}

pub fn render_text(
    report: Report,
    include_modules: bool,
    include_packages: bool,
    include_files: bool,
) -> string {
    let output = text::StringBuilder::new();
    let widths = column_widths(report.totals);
    output.write_line("GoML source statistics: " + display_path(report.root));
    output.write_line(
        f"Modules: {report.modules.len()}  Packages: {report.packages.len()}  Test files: {report.totals.test_files}",
    );
    output.write_line("");
    header(output, "Scope", widths);
    row(output, report.totals, "Total", widths);
    if include_modules {
        group_table(output, "Module directory", report.modules, widths);
        if report.unassigned.files > 0 {
            row(output, report.unassigned, "(outside discovered modules)", widths);
        }
    }
    if include_packages {
        group_table(output, "Package directory", report.packages, widths);
    }
    if include_files {
        output.write_line("");
        header(output, "File", widths);
        for file in report.files {
            row(output, file.counts, file.path, widths);
        }
    }
    output.finish()
}
